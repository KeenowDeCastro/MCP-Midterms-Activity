# Copy this file to .env and fill in your own values. Never commit .env.

# Where the server listens. Keep HOST=127.0.0.1 so only the tunnel (ngrok) can reach it.
PORT=8787
HOST=127.0.0.1

# The sandbox root. Every path an agent sends is resolved inside this folder.
WORKSPACE_ROOT=./workspace

# Where tool-call logs (tool-calls.jsonl) are written. Keep this OUTSIDE the workspace.
LOG_DIR=./logs

# Access tokens, one per role: role=token,role=token
# Generate each token with:  npm run token
# Roles and their allowed tools are defined in config/roles.json
AUTH_TOKENS=builder=REPLACE_ME_WITH_A_LONG_RANDOM_TOKEN,reviewer=REPLACE_ME_WITH_ANOTHER_TOKEN

# Set to true only for quick local testing with MCP Inspector. Never true when the tunnel is up.
ALLOW_NO_AUTH=false

# Gate for the destructive delete_file tool.
ALLOW_DELETE=true

# Identity used for commits that agents make with git_commit.
GIT_AUTHOR_NAME=MCP Agent
GIT_AUTHOR_EMAIL=agent@example.com

# Your reserved ngrok static domain (used by ecosystem.config.cjs).
NGROK_DOMAIN=your-name.ngrok-free.app
